PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Use none for frontend/API on different sites in production (requires HTTPS).
COOKIE_SAME_SITE=lax
DB_CONNECT_STRING=mongodb://127.0.0.1:27017/hackorbit
JWT_KEY=replace-with-a-long-random-secret
REDIS_PASS=replace-with-your-redis-password

# Optional automatic footer feedback email. Without SMTP, visitors use email/WhatsApp drafts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional TURN relay for peer video calls on restrictive networks.
# Use credentials from your TURN provider; never commit real values.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
